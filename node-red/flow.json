  {
    "id": "petcore-api-normalize",
    "type": "function",
    "z": "556f124d2b9639ba",
    "name": "Enviar evento individual à API",
    "func": "const allowed=['petcore/status','petcore/horario','petcore/comida']; if(!allowed.includes(msg.topic)) return null; const value=typeof msg.payload==='string'?msg.payload:JSON.stringify(msg.payload); msg.url=env.get('PETCORE_API_URL')||'http://localhost:5080/api/measurements'; msg.headers={'content-type':'application/json'}; msg.payload={deviceId:env.get('PETCORE_DEVICE_ID')||'PetCoreESP32',topic:msg.topic,value,eventTime:new Date().toISOString(),eventId:msg._msgid,data:{topic:msg.topic,value}}; return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
