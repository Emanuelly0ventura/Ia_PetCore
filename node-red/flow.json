  {
    "id": "a3f05a3f6a261a35",
    "type": "function",
    "z": "556f124d2b9639ba",
    "name": "Salvar dados",
    "func": "const p=msg.payload||{}; const keys=[\"petcore/horario\",\"petcore/status\",\"petcore/comida\"]; if(!keys.every(k=>typeof p[k]===\"string\")) return null; const q=v=>String(v).replace(/'/g,\"''\"); msg.topic=`INSERT INTO petcore (horario,status,comida) VALUES ('${q(p[\"petcore/horario\"])}','${q(p[\"petcore/status\"])}','${q(p[\"petcore/comida\"])}');`; return msg;",
